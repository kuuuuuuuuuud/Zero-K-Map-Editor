#!/bin/sh
# Enable once per clone: git config core.hooksPath tools/githooks
# Bumps the patch version on every commit on main/master.
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
case "$branch" in
  main|master)
    py=.venv/Scripts/python.exe; [ -x "$py" ] || py=python
    "$py" tools/bump_version.py >/dev/null && git add atlasforge/__init__.py ;;
esac
